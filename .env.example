# ---- Claude (LLM) ----
# LLM_BACKEND=api        -> direct Claude API, needs ANTHROPIC_API_KEY
# LLM_BACKEND=agent_sdk  -> Claude Agent SDK, reuses your local `claude` login (no key needed)
LLM_BACKEND=agent_sdk
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5          # or claude-sonnet-5-5 / claude-haiku-4-5
LLM_EFFORT=medium                  # low | medium | high

# ---- Jev (TypeSafe AI) ----
TYPESAFE_API_KEY=sk-...
JEV_CONFIDENCE=0.75                # below this the hybrid agent falls back to the LLM

# ---- Jira via MCP (mcp-atlassian) ----
JIRA_URL=https://your-site.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=your_api_token
# Command used to start the Jira MCP server. "mcp-atlassian" is installed in the venv.
# If you prefer uvx: MCP_ATLASSIAN_CMD=uvx mcp-atlassian
MCP_ATLASSIAN_CMD=mcp-atlassian

# ---- Demo target ----
BASE_URL=https://www.saucedemo.com
